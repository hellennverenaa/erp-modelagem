# Copie para backend/.env e configure os serviços locais.
NODE_ENV=development
ERP_PORT=3001

# Conexão PostgreSQL. O schema é sempre erp_modelagem.
# Codifique caracteres especiais do usuário/senha na URL (ex.: @ vira %40).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/postgres

# Mesmo segredo usado pelo serviço que emite os tokens JWT.
JWT_SECRET=mesmo_segredo_do_servico_de_autenticacao
# URL base; o backend acrescenta /auth/login e /user/email/:matricula.
DASS_AUTH_URL=http://127.0.0.1:2399/api

# Origens autorizadas, separadas por vírgula.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Envio dos e-mails de checklist por Nodemailer.
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_USER=erp@seudominio.com
SMTP_PASS=senha_do_servidor_smtp
